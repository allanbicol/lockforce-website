---
// The Lockforce reticle mark, redrawn as SVG so it can be coloured and animated.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<svg class:list={['reticle', cls]} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <g class="reticle__ticks">
    <line class="reticle__tick" x1="2" y1="50" x2="29" y2="50"></line>
    <line class="reticle__tick" x1="71" y1="50" x2="84" y2="50"></line>
    <line class="reticle__tick reticle__tick--steel" x1="84" y1="50" x2="98" y2="50"></line>
    <line class="reticle__tick reticle__tick--steel" x1="50" y1="2" x2="50" y2="16"></line>
    <line class="reticle__tick" x1="50" y1="16" x2="50" y2="29"></line>
    <line class="reticle__tick reticle__tick--steel" x1="50" y1="71" x2="50" y2="98"></line>
  </g>
  <circle class="reticle__ring" cx="50" cy="50" r="22"></circle>
  <circle class="reticle__dot" cx="50" cy="50" r="6.5"></circle>
</svg>
