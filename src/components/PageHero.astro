---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Rule from './Rule.astro';
interface Props { title: string; lead: string; image?: ImageMetadata; alt?: string }
const { title, lead, image, alt = '' } = Astro.props;
---
<section class:list={['page-hero theme-dark', { 'page-hero--media': image }]}>
  {image && (
    <div class="page-hero__bg" data-intro-media>
      <Image src={image} alt={alt} widths={[640, 1024, 1600]} sizes="100vw" loading="eager" />
      <span class="page-hero__scan" aria-hidden="true"></span>
    </div>
  )}
  <div class="wrap page-hero__inner">
    <div class="page-hero__copy">
      <h1 class="display display--page" data-intro-title>{title}</h1>
      <p class="lead" data-intro-fade>{lead}</p>
      {Astro.slots.has('default') && <div class="page-hero__actions" data-intro-fade><slot /></div>}
    </div>
  </div>
  <div class="wrap"><Rule /></div>
</section>
