---
import { link } from '../lib/url';
import { Image } from 'astro:assets';
import { nav } from '../data/site';
import { img } from '../lib/images';
import Arrow from './Arrow.astro';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const menuItems = [...nav, { label: 'FAQs', href: '/faqs/' }, { label: 'Contact us', href: '/contact-us/' }];
---
<header class="header" data-header>
  <div class="header__bar wrap">
    <a class="header__logo" href={link('/')} aria-label="Lockforce International, home">
      <Image src={img('logo-white.png')} alt="Lockforce" width={348} loading="eager" />
    </a>
    <nav class="header__nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={link(item.href)} aria-current={path === link(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--red btn--small header__cta" href={link('/contact-us/')}>
      <span>Contact us</span><Arrow />
    </a>
    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <span class="header__toggle-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
  <span class="header__progress" data-progress aria-hidden="true"></span>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav class="menu__nav wrap" aria-label="Mobile">
    <ul>
      {menuItems.map((item) => (
        <li>
          <a href={link(item.href)} aria-current={path === link(item.href) ? 'page' : undefined}>
            <span>{item.label}</span><Arrow />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>
