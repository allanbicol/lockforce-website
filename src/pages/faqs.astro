---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image } from 'astro:assets';
import { faqs } from '../data/site';
import { img } from '../lib/images';
---
<Base title="Frequently asked questions" description="Answers to common questions about Lockforce: why choose us, what we offer, document security, security risk management and occupational health and safety.">
  <PageHero
    title="Frequently asked questions"
    lead="Straight answers about who we are, what we offer and how we work."
    image={img('training-workshop.jpg')}
    alt="A Lockforce workshop in session, with delegates seated in a conference room"
  />

  <section class="section theme-paper">
    <div class="wrap faq-layout">
      <div class="faq">
        {faqs.map((f, i) => (
          <div class="faq__item">
            <h2>
              <button class="faq__q" type="button" aria-expanded="true" aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
                <span>{f.q}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </button>
            </h2>
            <div class="faq__a" id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div>
                <div class="prose">
                  {f.paras.map((p) => <p>{p}</p>)}
                  {f.list && <ul class="ticks">{f.list.map((li) => <li>{li}</li>)}</ul>}
                  {f.after?.map((p) => <p>{p}</p>)}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <aside class="faq-aside">
        <div class="frame" data-clip>
          <Image src={img('first-aid.jpg')} alt="A first aid training exercise with a practice mannequin" widths={[480, 800]} sizes="(min-width: 960px) 32vw, 100vw" />
        </div>
        <p>Can’t find your answer here? Ask us directly and the right person will come back to you.</p>
      </aside>
    </div>
  </section>

  <CtaBand title="Still have a question?" body="Send it through and the right person will come back to you." label="Ask us directly" />
</Base>
